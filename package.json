{
  "name": "generative-ui-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web-demo": "node apps/web-demo/scripts.mjs dev",
    "build": "turbo run build && pnpm build:web-demo",
    "build:web-demo": "node apps/web-demo/scripts.mjs build",
    "check:boundaries": "node scripts/check-dependency-boundaries.mjs",
    "typecheck": "turbo run typecheck && node --check apps/web-demo/scripts.mjs && node --check apps/web-demo/test.mjs && node --check scripts/e2e-web-demo.mjs",
    "test": "pnpm build && vitest run tests/workspace && node scripts/check-contract-package-installation.mjs && turbo run test && pnpm test:web-demo && pnpm test:e2e:web-demo",
    "test:e2e:http": "pnpm --filter @generative-ui/ui-compiler-service test:e2e:http",
    "test:web-demo": "node apps/web-demo/test.mjs",
    "test:e2e:web-demo": "node scripts/e2e-web-demo.mjs",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "docs:lint": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#.turbo\"",
    "docs:spell": "cspell \"**/*.md\" --no-progress",
    "docs:check": "pnpm docs:lint && pnpm docs:spell",
    "validate": "pnpm lint && pnpm check:boundaries && pnpm typecheck && pnpm test && pnpm build && pnpm docs:check",
    "test:docker": "node scripts/smoke-ui-compiler-service-container.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "prepare": "lefthook install",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@changesets/cli": "2.31.1",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@types/node": "26.1.2",
    "cspell": "10.0.1",
    "lefthook": "2.1.10",
    "markdownlint-cli2": "0.23.2",
    "tsup": "8.5.1",
    "tsx": "4.23.1",
    "turbo": "2.10.7",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
