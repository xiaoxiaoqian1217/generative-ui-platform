{
  "name": "generative-ui-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:ag-ui-mock": "pnpm --filter @generative-ui/ag-ui-mock dev",
    "dev:copilot-runtime": "pnpm --filter @generative-ui/copilot-runtime dev",
    "dev:map-validation-agent": "pnpm --filter @generative-ui/map-validation-agent dev",
    "dev:web-workbench": "pnpm --filter @generative-ui/web-workbench dev",
    "build": "turbo run build",
    "build:web-workbench": "pnpm --filter @generative-ui/web-workbench build",
    "typecheck": "turbo run typecheck",
    "test": "pnpm build && turbo run test --concurrency=1 && pnpm test:e2e:web-workbench",
    "test:web-workbench": "pnpm --filter @generative-ui/web-workbench test",
    "test:e2e:web-workbench": "pnpm --filter @generative-ui/web-workbench test:e2e",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "docs:lint": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#.turbo\"",
    "docs:spell": "cspell \"**/*.md\" --no-progress",
    "docs:check": "pnpm docs:lint && pnpm docs:spell",
    "validate": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm docs:check",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "prepare": "lefthook install",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.2",
    "@changesets/cli": "2.29.5",
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@types/node": "24.0.15",
    "@types/ws": "8.18.1",
    "cspell": "9.1.1",
    "lefthook": "1.11.14",
    "markdownlint-cli2": "0.18.1",
    "tsup": "8.5.0",
    "tsx": "4.20.3",
    "turbo": "2.5.5",
    "typescript": "5.8.3",
    "vitest": "3.2.6",
    "ws": "8.21.1"
  }
}
