{
  "name": "generative-ui-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web-workbench": "pnpm --filter @generative-ui/web-workbench dev",
    "dev:platform": "node scripts/dev-platform.mjs",
    "stop:platform": "node scripts/stop-platform.mjs",
    "check:platform-environment": "node scripts/check-platform-environment.mjs --require-build",
    "check:doctor": "node scripts/check-platform-environment.mjs",
    "setup": "node scripts/setup-development.mjs",
    "test:provider-smoke": "node scripts/provider-smoke.mjs",
    "build": "turbo run build",
    "build:web-workbench": "pnpm --filter @generative-ui/web-workbench build",
    "build:platform": "turbo run build",
    "check:boundaries": "node scripts/check-dependency-boundaries.mjs",
    "typecheck": "turbo run typecheck",
    "test": "pnpm build && vitest run tests/workspace && node scripts/check-contract-package-installation.mjs && turbo run test --concurrency=1 && pnpm test:e2e:web-workbench && pnpm test:e2e:platform",
    "test:web-workbench": "pnpm --filter @generative-ui/web-workbench test",
    "test:e2e:web-workbench": "pnpm --filter @generative-ui/web-workbench test:e2e",
    "test:e2e:platform": "node scripts/test-e2e-platform.mjs",
    "verify:platform": "pnpm build:platform && pnpm check:platform-environment && pnpm test:e2e:platform",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "docs:lint": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#.turbo\"",
    "docs:spell": "cspell \"**/*.md\" --no-progress",
    "docs:check": "pnpm docs:lint && pnpm docs:spell",
    "validate": "pnpm lint && pnpm check:boundaries && pnpm typecheck && pnpm test && pnpm build && pnpm docs:check",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "prepare": "lefthook install",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@changesets/cli": "3.0.1",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/node": "26.2.0",
    "@types/ws": "8.18.1",
    "cspell": "10.0.1",
    "lefthook": "2.1.10",
    "markdownlint-cli2": "0.23.2",
    "tsup": "8.5.1",
    "tsx": "4.23.12",
    "turbo": "2.10.11",
    "typescript": "5.8.3",
    "vitest": "4.1.11",
    "ws": "8.21.1"
  }
}
