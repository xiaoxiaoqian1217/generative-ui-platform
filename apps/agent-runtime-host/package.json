{
  "name": "@generative-ui/agent-runtime-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/dev-application.mjs runtime",
    "build": "tsup src/main.ts --format esm --external node:sqlite --clean --out-dir dist",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ag-ui/core": "0.0.57",
    "@ag-ui/client": "0.0.57",
    "@copilotkit/runtime": "1.63.2",
    "@generative-ui/ag-ui-adapter": "workspace:*",
    "@generative-ui/business-agent-adapter": "workspace:*",
    "@generative-ui/component-catalog-schema": "workspace:*",
    "@generative-ui/presentation-pipeline": "workspace:*",
    "@generative-ui/presentation-contract": "workspace:*",
    "@generative-ui/runtime-contract": "workspace:*",
    "express": "5.1.0",
    "openai": "7.4.0",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "tsup": "8.5.0",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "3.2.6"
  }
}
