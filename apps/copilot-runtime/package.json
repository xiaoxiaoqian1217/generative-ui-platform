{
  "name": "@generative-ui/copilot-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/server.ts --format esm --dts --clean --out-dir dist",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "smoke:sacs": "node scripts/smoke-sacs.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@a2ui/web_core": "0.9.0",
    "@ag-ui/a2ui-toolkit": "0.0.4",
    "@ag-ui/client": "0.0.57",
    "@ag-ui/core": "0.0.57",
    "@ag-ui/langgraph": "0.0.42",
    "@copilotkit/runtime": "1.64.1",
    "@generative-ui/a2ui-catalog": "workspace:*",
    "@generative-ui/shared-types": "workspace:*",
    "rxjs": "7.8.1",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@types/node": "24.0.15",
    "tsup": "8.5.0",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "3.2.6"
  }
}
