{
  "name": "@generative-ui/web-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @generative-ui/ag-ui-mock build && pnpm --filter @generative-ui/copilot-runtime build && pnpm build && playwright test"
  },
  "dependencies": {
    "@ag-ui/core": "0.0.57",
    "@copilotkit/core": "1.64.1",
    "@copilotkit/vue": "1.64.1",
    "@generative-ui/shared-types": "workspace:*",
    "maplibre-gl": "6.3.0",
    "markdown-it": "14.1.0",
    "vue": "3.5.40",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/markdown-it": "14.1.2",
    "@types/ws": "8.18.1",
    "@generative-ui/ag-ui-mock": "workspace:*",
    "@generative-ui/copilot-runtime": "workspace:*",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.6",
    "jsdom": "26.1.0",
    "vite": "7.3.6",
    "vitest": "3.2.6",
    "vue-tsc": "3.3.9",
    "ws": "8.21.1"
  }
}
