{
  "name": "@generative-ui/web-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/dev-application.mjs workbench",
    "build": "vite build",
    "build:e2e": "node scripts/build-e2e.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @generative-ui/ag-ui-mock build && pnpm build:e2e && playwright test",
    "test:e2e:platform": "playwright test --config playwright.platform.config.ts"
  },
  "dependencies": {
    "@ag-ui/core": "0.0.57",
    "@copilotkit/core": "1.64.1",
    "@copilotkit/vue": "1.64.1",
    "@generative-ui/compiler-contract": "workspace:*",
    "@generative-ui/presentation-contract": "workspace:*",
    "@generative-ui/runtime-contract": "workspace:*",
    "@generative-ui/shared-types": "workspace:*",
    "maplibre-gl": "5.14.0",
    "markdown-it": "14.1.0",
    "vue": "3.5.40",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@generative-ui/ag-ui-mock": "workspace:*",
    "@playwright/test": "1.62.1",
    "@types/markdown-it": "14.1.2",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.5.0",
    "jsdom": "30.0.1",
    "vite": "8.2.2",
    "vitest": "3.2.6",
    "vue-tsc": "3.3.11",
    "ws": "8.21.1"
  }
}
